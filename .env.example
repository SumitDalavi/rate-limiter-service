# .env.example — rate-limiter-service
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Redis Connection ──────────────────────────────────────────────────────
# Default: redis://localhost:6379 (can point to local miniredis / test cluster)
# Production: rediss://:auth@memorystore:6379
REDIS_URL=redis://localhost:6379

# ── Rate Limiter Tuning ───────────────────────────────────────────────────
DEFAULT_LIMIT=100
DEFAULT_WINDOW_S=60

# ── Dynamic Config Hot-Reload ─────────────────────────────────────────────
# UNSET (default): Boot-time static config
# SET to mount path (Kubernetes ConfigMap): Live hot-reload without pod restart
CONFIG_MOUNT_PATH=

# ── Server Port ───────────────────────────────────────────────────────────
PORT=8080
